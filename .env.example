# Copy to .env only if you enable OPTIONAL real-model adapters.
# The default test/eval path is fully deterministic and needs NONE of these.

# Keep the uv-managed virtualenv OUT of iCloud Drive (avoids sync locking).
UV_PROJECT_ENVIRONMENT=${HOME}/.uv-envs/policy-gated-mcp

# --- Optional model adapters (all disabled unless a key is present) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- Policy engine selection ---
# auto (default): use `opa` if on PATH, else the native Python mirror.
# opa   : require the opa CLI (error if missing).
# native: force the native Python engine.
# POLICY_ENGINE=auto
